{%- assign steps = product.metafields.custom.etapes_utilisation.value -%}

{%- if steps != blank -%}
  {{ 'knr-how-to-use.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'knr-scroll-progress.js' | asset_url }}" defer></script>

  {%- assign list_id = 'knr-how-to-use-' | append: section.id -%}

  <section
    class="knr-how-to-use"
    {% if section.settings.heading != blank %}
      aria-labelledby="KnrHowToUseHeading-{{ section.id }}"
    {% endif %}
  >
    {%- if section.settings.heading != blank -%}
      <h2 id="KnrHowToUseHeading-{{ section.id }}" class="knr-how-to-use__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <ol class="knr-how-to-use__steps" id="{{ list_id }}">
      {%- for step in steps -%}
        {%- assign image = step.image.value -%}
        <li class="knr-how-to-use__step">
          <div class="knr-how-to-use__media knr-focal" style="{% if image %}{% render 'knr-focal-style', image: image %}{% endif %}">
            {%- if image -%}
              {{
                image
                | image_url: width: 1350
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900, 1350',
                  sizes: '(min-width: 750px) calc((100vw - 96px) / 3), 255px',
                  alt: image.alt
              }}
            {%- endif -%}
          </div>

          <div class="knr-how-to-use__details">
            <p class="knr-how-to-use__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</p>
            <h3 class="knr-how-to-use__title">{{ step.titre.value }}</h3>
            {%- if step.texte != blank -%}
              <div class="knr-how-to-use__text">{{ step.texte | metafield_tag }}</div>
            {%- endif -%}
            {%- if step.lien != blank and section.settings.link_label != blank -%}
              <a class="knr-how-to-use__link" href="{{ step.lien.value }}">
                {{- section.settings.link_label -}}
                <span class="knr-visually-hidden"> : {{ step.titre.value }}</span>
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if steps.size > 1 -%}
      <div
        class="knr-scroll-progress knr-how-to-use__progress"
        style="--knr-progress-count: {{ steps.size }};"
        aria-hidden="true"
        data-knr-scroll-progress="{{ list_id }}"
      >
        <span></span>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "KNR - How to use",
  "class": "knr-section-how-to-use",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Étapes issues du métachamp produit custom.etapes_utilisation (métaobjets « Étape d'utilisation »)."
    },
    { "type": "text", "id": "heading", "label": "Titre", "default": "How to use" },
    { "type": "text", "id": "link_label", "label": "Libellé du lien d'une étape", "default": "Lire plus" }
  ],
  "presets": [{ "name": "KNR - How to use" }]
}
{% endschema %}
