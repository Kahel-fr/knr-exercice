{%- assign blog = section.settings.blog -%}

{%- if blog != blank and blog.articles_count > 0 -%}
  {{ 'knr-latest-news.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'knr-scroll-progress.js' | asset_url }}" defer></script>

  {%- liquid
    assign list_id = 'KnrNewsList-' | append: section.id
    assign shown_count = blog.articles_count | at_most: section.settings.limit
  -%}

  <section class="knr-news" aria-labelledby="KnrNewsHeading-{{ section.id }}">
    <div class="knr-news__header">
      <h2 id="KnrNewsHeading-{{ section.id }}" class="knr-news__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.view_all_label != blank -%}
        <a class="knr-news__all" href="{{ blog.url }}">{{ section.settings.view_all_label }}</a>
      {%- endif -%}
    </div>

    <ul class="knr-news__list" id="{{ list_id }}">
      {%- for article in blog.articles limit: section.settings.limit -%}
        <li class="knr-news__card">
          <div class="knr-news__media">
            {%- if article.image -%}
              {{
                article.image
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 1000',
                  sizes: '(min-width: 750px) calc((100vw - 104px) / 4), 255px',
                  alt: ''
              }}
            {%- endif -%}
          </div>

          <div class="knr-news__details">
            {%- assign tag = article.tags | first -%}
            {%- if tag != blank -%}
              <p class="knr-news__tag">{{ tag }}</p>
            {%- endif -%}
            <h3 class="knr-news__title">
              <a class="knr-news__link" href="{{ article.url }}">{{ article.title }}</a>
            </h3>
            <p class="knr-news__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>

    {%- if shown_count > 1 -%}
      <div
        class="knr-scroll-progress knr-news__progress"
        style="--knr-progress-count: {{ shown_count }};"
        aria-hidden="true"
        data-knr-scroll-progress="{{ list_id }}"
      >
        <span></span>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "KNR - Latest news",
  "class": "knr-section-latest-news",
  "settings": [
    {
      "type": "paragraph",
      "content": "Pour chaque article : image à la une, premier tag (rubrique), titre et extrait."
    },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Latest news" },
    { "type": "text", "id": "view_all_label", "label": "Lien voir tout", "default": "Voir tous les articles" },
    { "type": "range", "id": "limit", "label": "Nombre d'articles", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "KNR - Latest news" }]
}
{% endschema %}
