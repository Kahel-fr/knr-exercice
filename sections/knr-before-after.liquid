{%- liquid
  assign image_before = product.metafields.custom.image_avant.value
  assign image_after = product.metafields.custom.image_apres.value
  assign intro = product.metafields.custom.temoignages_intro.value
  assign testimonials = product.metafields.custom.temoignages.value
  assign slides_id = 'KnrTestimonials-' | append: section.id

  assign has_compare = false
  if image_before != blank and image_after != blank
    assign has_compare = true
  endif
-%}

{%- if has_compare or testimonials != blank -%}
  {{ 'knr-before-after.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'knr-before-after.js' | asset_url }}" defer></script>

  <section
    class="knr-before-after"
    {% if section.settings.heading != blank %}
      aria-labelledby="KnrBeforeAfterHeading-{{ section.id }}"
    {% endif %}
  >
    <div class="knr-before-after__header">
      {%- if section.settings.heading != blank -%}
        <h2 id="KnrBeforeAfterHeading-{{ section.id }}" class="knr-before-after__heading">
          {{- section.settings.heading -}}
        </h2>
      {%- endif -%}
      {%- if intro != blank -%}
        <p class="knr-before-after__intro">{{ intro | newline_to_br }}</p>
      {%- endif -%}
    </div>

    {%- if has_compare -%}
      <div class="knr-before-after__compare" style="--knr-position: 50%;" data-knr-compare>
        {{
          image_after
          | image_url: width: 2560
          | image_tag:
            loading: 'lazy',
            widths: '400, 750, 1100, 1500, 2000, 2560',
            sizes: '(min-width: 750px) calc(100vw - 160px), calc(100vw - 48px)',
            alt: image_after.alt
        }}
        {{
          image_before
          | image_url: width: 2560
          | image_tag:
            class: 'knr-before-after__before',
            loading: 'lazy',
            widths: '400, 750, 1100, 1500, 2000, 2560',
            sizes: '(min-width: 750px) calc(100vw - 160px), calc(100vw - 48px)',
            alt: image_before.alt
        }}
        <span class="knr-before-after__label" aria-hidden="true">{{ section.settings.label_before }}</span>
        <span class="knr-before-after__label knr-before-after__label--after" aria-hidden="true">
          {{- section.settings.label_after -}}
        </span>
        <span class="knr-before-after__divider" aria-hidden="true">
          <span class="knr-before-after__handle">{% render 'knr-icon', icon: 'drag' %}</span>
        </span>
        <input
          class="knr-before-after__range"
          type="range"
          min="0"
          max="100"
          value="50"
          aria-label="{{ section.settings.slider_label }}"
          data-knr-compare-range
        >
      </div>
    {%- endif -%}

    {%- if testimonials != blank -%}
      <div class="knr-before-after__testimonials" data-knr-testimonials>
        <ul class="knr-before-after__slides" id="{{ slides_id }}" aria-live="polite">
          {%- for testimonial in testimonials -%}
            <li class="knr-before-after__slide{% if forloop.first %} is-active{% endif %}">
              <p class="knr-before-after__meta">
                {%- render 'knr-stars', rating: testimonial.note.value.rating, max: testimonial.note.value.scale_max -%}
                <span>{{ testimonial.auteur.value }}</span>
              </p>
              <blockquote class="knr-before-after__quote">{{ testimonial.texte.value | newline_to_br }}</blockquote>
            </li>
          {%- endfor -%}
        </ul>

        {%- if testimonials.size > 1 -%}
          <div class="knr-before-after__nav">
            <button type="button" class="knr-before-after__arrow" aria-controls="{{ slides_id }}" data-knr-testimonials-nav="-1">
              {%- render 'knr-icon', icon: 'chevron-bold-left' -%}
              <span class="knr-visually-hidden">{{ section.settings.prev_label }}</span>
            </button>
            <button type="button" class="knr-before-after__arrow" aria-controls="{{ slides_id }}" data-knr-testimonials-nav="1">
              {%- render 'knr-icon', icon: 'chevron-bold-right' -%}
              <span class="knr-visually-hidden">{{ section.settings.next_label }}</span>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "KNR - Avant / Après",
  "class": "knr-section-before-after",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Contenu issu des métachamps produit : custom.temoignages_intro, custom.image_avant, custom.image_apres et custom.temoignages (métaobjets « Avis client »)."
    },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce que disent nos clientes" },
    { "type": "text", "id": "label_before", "label": "Libellé avant", "default": "Before" },
    { "type": "text", "id": "label_after", "label": "Libellé après", "default": "After" },
    { "type": "text", "id": "slider_label", "label": "Libellé accessible du curseur", "default": "Comparer avant et après" },
    { "type": "text", "id": "prev_label", "label": "Libellé accessible de la flèche gauche", "default": "Témoignage précédent" },
    { "type": "text", "id": "next_label", "label": "Libellé accessible de la flèche droite", "default": "Témoignage suivant" }
  ],
  "presets": [{ "name": "KNR - Avant / Après" }]
}
{% endschema %}
