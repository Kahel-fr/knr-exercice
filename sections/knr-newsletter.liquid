{{ 'knr-newsletter.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign form_id = 'KnrNewsletterForm-' | append: section.id
  assign email_id = 'KnrNewsletterEmail-' | append: section.id
  assign error_id = 'KnrNewsletterError-' | append: section.id
-%}

<section
  class="knr-newsletter"
  {% if section.settings.heading != blank %}
    aria-labelledby="KnrNewsletterHeading-{{ section.id }}"
  {% endif %}
>
  {%- if section.settings.image != blank -%}
    <div class="knr-newsletter__media">
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '400, 700, 1000, 1400',
          sizes: '(min-width: 750px) calc(50vw - 40px), calc(100vw - 48px)',
          alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="knr-newsletter__content">
    {%- if section.settings.heading != blank -%}
      <h2 id="KnrNewsletterHeading-{{ section.id }}" class="knr-newsletter__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="knr-newsletter__signup">
      {%- form 'customer', id: form_id, class: 'knr-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="knr-newsletter__message" role="status">{{ section.settings.success_message }}</p>
        {%- else -%}
          <div class="knr-newsletter__field">
            <label class="knr-visually-hidden" for="{{ email_id }}">{{ section.settings.email_label }}</label>
            <input
              id="{{ email_id }}"
              class="knr-newsletter__input"
              type="email"
              name="contact[email]"
              placeholder="{{ section.settings.email_label }}"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="{{ error_id }}"
              {% endif %}
            >
            <button type="submit" class="knr-newsletter__submit">{{ section.settings.submit_label }}</button>
          </div>
          {%- if form.errors -%}
            <div id="{{ error_id }}" class="knr-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.disclaimer != blank -%}
        <p class="knr-newsletter__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "KNR - Newsletter",
  "class": "knr-section-newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "L'alliance de la science botanique et du luxe naturel pour une peau visiblement rajeunie en 4 semaines." },
    { "type": "text", "id": "email_label", "label": "Libellé e-mail", "default": "E-mail" },
    { "type": "text", "id": "submit_label", "label": "Bouton", "default": "S'inscrire" },
    { "type": "text", "id": "success_message", "label": "Message de confirmation", "default": "Merci pour votre inscription." },
    { "type": "text", "id": "disclaimer", "label": "Mention" }
  ],
  "presets": [{ "name": "KNR - Newsletter" }]
}
{% endschema %}
